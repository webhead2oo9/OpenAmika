# The template of brain/.env (git-ignored): scripts/setup_windows.ps1 copies it there; fill in what you use (the
# first-run wizard on the Use page writes your OpenRouter key here too). Secrets only: everything else lives in
# settings.json and config/*.json (editable from the Setup page at http://localhost:53000). By hand:
#
#   copy .env.example brain\.env
#
# OpenRouter (below) is the recommended way to run her language model: a few dollars a month. Fully local (every LLM
# role on an Ollama model of 27B or more, Setup → Brain): no key is needed at all; brain/.env may stay empty.

# ── OpenRouter: the default provider for all four LLM roles (https://openrouter.ai/keys) ──────────────
OPENROUTER_API_KEY=

# ── Optional: Alibaba Cloud Model Studio, an alternative provider for the roles ──────────────────────
# Also set your workspace in config/alibaba_models.json.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# ── Optional: legacy cloud embedder (the default embedder is the local EmbeddingGemma 2 service);
#    only needed if you set "embedding_provider": "gemini" in config/build_f.json ─────────────────────
GEMINI_API_KEY=

# ── Optional: legacy direct providers (off by default; Anthropic and xAI are disabled in
#    config/llm_roles.json "disabled_providers") ──────────────────────────────────────────────────
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Separate Anthropic keys for the background work. Leave these two commented out unless you set them:
# an empty value would replace the ANTHROPIC_API_KEY fallback.
# CONSOLIDATION_ANTHROPIC_KEY=
# THINKING_ANTHROPIC_KEY=

# ── Advanced: a different deep-tier template file in brain/ (default 例子.txt). Keep it commented out
#    unless you use it: an empty value would replace the default file name. ─────────────────────────
# TEMPLATE_FILE=

# ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Read by the code but NOT set here (listed so the inventory is complete):
#   launch.py passes these to the services it starts, from settings.json:
#     HANE_HOST, HANE_PORT, HANE_URL, AMIKA_CHAT_URL, AMIKA_LOCAL_MODEL_URL, AMIKA_EMBEDDING_URL,
#     AMIKA_VLM_URL, AMIKA_TTS_URL, AMIKA_TTS_CHARACTER, YUMEHA_HOST, YUMEHA_PORT, YUMEHA_MODEL,
#     YUMEHA_DEVICE, AMIKA_MESSENGERS_URL, AMIKA_MESSENGERS_PORT
#   the tool servers read these from the "env" block of their entry in config/tools.json:
#     HERMES_URL, HERMES_API_KEY, HERMES_SESSION, HERMES_PROVIDER, HERMES_MODEL, HERMES_INSTRUCTIONS,
#     HERMES_SURFACE_BROWSER, NANOMUSE_URL, NANOMUSE_TOKEN, NANOMUSE_TOKEN_FILE, NANOMUSE_THREAD,
#     NANOMUSE_LANGUAGE, AMIKA_MQTT_HOST, AMIKA_MQTT_PORT, AMIKA_MQTT_BASE_TOPIC, AMIKA_IOT_DATA_DIR
#   Hugging Face cache location (standard): HF_HOME, HF_HUB_CACHE
#   Discord / Telegram bot tokens live in config/messengers.json (git-ignored), set from Setup → Text her.
